# Copy to .env for local development (bun run dev). For Docker use deploy/.env.example.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase
SESSION_SECRET=
SEED_PROFILE_EMAIL=you@example.com
TRUST_PROXY=false
COOKIE_SECURE=false

# Public URL of the site (canonical links, sitemap, llms.txt, JSON-LD). Example: https://example.com
NUXT_PUBLIC_SITE_URL=

# PostHog analytics + session replay (optional; off when the key is empty). Host: https://us.i.posthog.com or https://eu.i.posthog.com
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics measurement ID (optional; empty = not loaded). Example: G-XXXXXXXXXX
NUXT_PUBLIC_GA_ID=
