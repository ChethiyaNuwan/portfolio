# Copy to .env for local development (bun run dev). For Docker use deploy/.env.example.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase
SESSION_SECRET=
SEED_PROFILE_EMAIL=you@example.com
TRUST_PROXY=false
COOKIE_SECURE=false

# Public URL of the site (canonical links, sitemap, llms.txt, JSON-LD). Example: https://example.com
NUXT_PUBLIC_SITE_URL=
