# Copy to deploy/.env and fill in. The app refuses to start without ADMIN_USERNAME / ADMIN_PASSWORD.

# Admin login (password must be at least 12 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# Signs the admin session cookie. 32+ random characters, e.g. `openssl rand -hex 32`.
# If empty, a random secret is generated on each start (you are logged out after restarts).
SESSION_SECRET=

# Email shown on the site and used for mailto: links on first run (editable later in the admin)
SEED_PROFILE_EMAIL=you@example.com

# Set to true only when running behind a reverse proxy you control (uses X-Forwarded-For for login rate limiting)
TRUST_PROXY=false

# Session cookie is Secure (HTTPS-only) by default in production. Set to false ONLY for plain-HTTP testing.
COOKIE_SECURE=true
